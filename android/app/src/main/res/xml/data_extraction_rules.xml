<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Provider API keys live in files/ and must never ride along in a backup. -->
    <cloud-backup>
        <exclude domain="file" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
