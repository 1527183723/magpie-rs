# Build artefacts
target/
*.apk
*.aab
*.keystore
*.jks
# ...except the well-known Android debug key, which has to stay stable across CI
# builds or update-installs fail with a signature mismatch.
!android/debug.keystore

# Android build intermediates
android/build/
android/app/build/
android/.gradle/

# Local signing material — never commit these
keystore.properties
release.keystore

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Local toolchain sandbox (only present on the machine that built the APK)
.toolchain/
